// The data-level glow sample (glow v3, no mod DLL): a Rat that glows magenta from the moment it spawns.
// The status NAME is the request: FwGlow_<rrggbb> or FwGlow_<rrggbbaa> (hex, either case). mewframework recognises it
// in its apply_status hook and draws the rim through the combat outline mask with mods/fw-glow/shaders/fw_unit_glow.shader;
// the rim lasts as long as the unit carries the status (any vanilla removal ends it). Grant it through any mechanism
// that applies a status: StatusOnSpawnIn / StatusOnBattleStart on a character, an ability's effects, a Temporary.
// `spawn FwGlowRat` in a fight (or mods/fw-glow/tests/data-glow.mewtest). docs/data-mods.md "Asking for a unit glow from data".
FwGlowRat {
    variant_of Rat
    passives {
        StatusOnSpawnIn {
            FwGlow_ff00ff 1
        }
    }
}

// The removal half (mods/fw-glow/tests/data-glow-expiry.mewtest): the same magenta glow granted as a Temporary that
// runs out at the end of the rat's first turn (the vanilla timed-status shape: Temporary { status … stacks … turns …
// expires_on_end_turn true }, e.g. passives/disorders.gon's Uncontrollable). When it expires the status is removed and
// the rim goes with it. 999 HP (the whole vanilla Rat properties block, health raised) so the autoplayed cats in the
// test fight cannot kill it before the check; spawn-only, no vanilla entry changed.
FwGlowTempRat {
    variant_of Rat
    properties {
        tag rat
        faction enemies
        movement 1
        health 999
        base_mana_regen 999
    }
    passives {
        StatusOnSpawnIn {
            Temporary {
                status FwGlow_ff00ff
                stacks 1
                turns 1
                expires_on_end_turn true
            }
        }
    }
}
