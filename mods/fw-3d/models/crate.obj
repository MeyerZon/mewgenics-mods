# crate.obj - the fw-3d sample model: a 0.8-unit crate standing on its tile.
# Hand-written for this repo (no game data). World units: 1 = one tile; axes are the game's (x, height, z),
# so +y is up and the base sits at height 0, centred on the anchor (tile centre or the unit's position).
# 8 corners, 6 face normals, 4 texture corners; 12 triangles, counter-clockwise seen from outside.
o crate
v -0.4 0.0 -0.4
v  0.4 0.0 -0.4
v  0.4 0.0  0.4
v -0.4 0.0  0.4
v -0.4 0.8 -0.4
v  0.4 0.8 -0.4
v  0.4 0.8  0.4
v -0.4 0.8  0.4
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn  0 -1  0
vn  0  1  0
vn  0  0 -1
vn  0  0  1
vn -1  0  0
vn  1  0  0
# bottom (y = 0, normal -y)
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
# top (y = 0.8, normal +y)
f 5/1/2 8/4/2 7/3/2
f 5/1/2 7/3/2 6/2/2
# back (z = -0.4, normal -z)
f 1/1/3 5/4/3 6/3/3
f 1/1/3 6/3/3 2/2/3
# front (z = +0.4, normal +z)
f 4/1/4 3/2/4 7/3/4
f 4/1/4 7/3/4 8/4/4
# left (x = -0.4, normal -x)
f 1/1/5 4/2/5 8/3/5
f 1/1/5 8/3/5 5/4/5
# right (x = +0.4, normal +x)
f 2/1/6 6/4/6 7/3/6
f 2/1/6 7/3/6 3/2/6
