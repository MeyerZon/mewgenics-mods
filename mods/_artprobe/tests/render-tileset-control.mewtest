mods: _artprobe, _autoplay
timeout: 90s
hide: false
# Tileset redirect probe, CONTROL (2026-10-22): the same scene as _tileprobe/tests/render-tileset-redirect.mewtest
# without the _tileprobe overlay — a plain Rat must draw as a Rat (no probe marker on screen).
wait frames 120
seed 42
enter TacticsTest
wait frames 60
shot "baseline"
cmd spawn Rat
expect console "Spawned Rat" within 10
wait frames 60
shot "rat 1"
wait frames 40
shot "rat 2"
quit
