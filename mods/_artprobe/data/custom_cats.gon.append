// test-only (raster + font probe, 2026-10-22): TomTom's parts with palette 54 (a reddish row: gray levels 1..14 map
// to clearly non-gray colours), so the probe can tell a palette-remapped gray from a passthrough one
ArtProbeRasterCat {
    default_frame 1000
    texture 1000
    claws 1
    palette 54

    voice male1
    pitch .5
}

// test-only (cat rig redirect probe): Mangy's distinctive part indices on TomTom's palette 9, so the parts the game
// draws into the rig's slots are recognisably not TomTom's defaults
ArtProbeParts {
    default_frame 1001
    texture 1000
    claws 1
    palette 9

    body 1001
    head 1001
    tail 1001
    leg1 1
    leg2 1001
    arm1 2
    arm2 1001
    lefteye 1001
    righteye 1
    lefteyebrow 1001
    righteyebrow 1001
    leftear 1
    rightear 1001
    mouth 1001

    voice male4
}
