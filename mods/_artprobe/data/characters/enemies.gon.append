// test-only: a Rat whose art is the ArtProbe clip from mods/_artprobe/swfs/probe.swf (built from art/probe.scene.json)
ArtProbe {
    variant_of Rat
    graphics {
        movieclip ArtProbe
        name "ENEMY_LILRAT_NAME"
        shadow_size .70
        tooltip "ENEMY_LILRAT_DESC"
    }
}

// test-only: a Rat drawn by the CatProbeColours cat rig (one passthrough colour per vanilla cat slot; npm run test:artprobe -- --cat)
ArtProbeCat {
    variant_of Rat
    graphics {
        movieclip CatProbeColours
        name "ENEMY_LILRAT_NAME"
        shadow_size .70
        tooltip "ENEMY_LILRAT_DESC"
    }
}

// test-only (experiment A0, 2026-10-21): a real cat — TomTom's parts (movieclip _CAT + custom_cat_data) — whose idle is
// the frame probe.swf appends to the vanilla cat clip (_Append_CatTest: probeIdleF / probeIdleB place the CatProbe rig —
// EMPTY slot sprites — as `ani`); npm run test:artprobe -- --cat-append shows the game filling the rig's slots by name
ArtProbeCatReal {
    variant_of TomTom
    graphics {
        movieclip _CAT
        name "ENEMY_TOMTOM_NAME"
        custom_cat_data TomTom
        scale 1.1
        shadow_size 1.1
        alt_animations [[idle probeIdle]]
        tooltip "ENEMY_TOMTOM_DESC"
    }
}

// test-only (experiment A0 control): TomTom whose idle is a *vanilla* appended label — crawlingIdle lives in
// catanis2.swf's _Append_CatTest — so a crash on ArtProbeCatReal but not here is about our frame's content
ArtProbeCatCtl {
    variant_of TomTom
    graphics {
        movieclip _CAT
        name "ENEMY_TOMTOM_NAME"
        custom_cat_data TomTom
        scale 1.1
        shadow_size 1.1
        alt_animations [[idle crawlingIdle]]
        tooltip "ENEMY_TOMTOM_DESC"
    }
}

// test-only (experiment A0 control 2): TomTom whose idle names a label no clip has — what does a missing label do?
ArtProbeCatMissing {
    variant_of TomTom
    graphics {
        movieclip _CAT
        name "ENEMY_TOMTOM_NAME"
        custom_cat_data TomTom
        scale 1.1
        shadow_size 1.1
        alt_animations [[idle noSuchLabelXYZ]]
        tooltip "ENEMY_TOMTOM_DESC"
    }
}

// test-only (loc-key probe, 2026-10-22): a Rat drawn by ArtProbeLoc — the probe marker plus ten DefineEditTexts whose
// initial texts are a vanilla key (ENEMY_TOMTOM_NAME), a key this mod adds (ARTPROBE_LOCTEST, text/combined.csv.append),
// each in vanilla's HTML wrapper and plain, their one-letter-off look-alikes and the two English values;
// npm run test:artprobe -- --loctext reads which key boxes the game localized
ArtProbeLoc {
    variant_of Rat
    graphics {
        movieclip ArtProbeLoc
        name "ENEMY_LILRAT_NAME"
        shadow_size .70
        tooltip "ENEMY_LILRAT_DESC"
    }
}

// test-only (wave probe, 2026-10-22): a real cat — TomTom's parts — whose idle is the appended `wave` animation
// (probe.scene.json: waveF / waveB on the _Append_CatTest donor place wavePose, a parts: "game" rig made with
// newCatAnimation whose arm1 / arm2 / head are keyed); npm run test:artprobe -- --cat-wave shows an animated pose
// getting the cat's own parts and moving
ArtProbeCatWave {
    variant_of TomTom
    graphics {
        movieclip _CAT
        name "ENEMY_TOMTOM_NAME"
        custom_cat_data TomTom
        scale 1.1
        shadow_size 1.1
        alt_animations [[idle wave]]
        tooltip "ENEMY_TOMTOM_DESC"
    }
}

// test-only (baked-glow probe, 2026-10-22): a Rat drawn by ArtProbeGlow — the marker, a square with a halo baked by
// glow.ts bakeGlow (#ff8000, blur 24, 4 bands), the identical unglowed control square and a swatch of the colour;
// npm run test:artprobe -- --glow-arena measures the halo in the arena
ArtProbeGlow {
    variant_of Rat
    graphics {
        movieclip ArtProbeGlow
        name "ENEMY_LILRAT_NAME"
        shadow_size .70
        tooltip "ENEMY_LILRAT_DESC"
    }
}

// test-only (back-facing probe, 2026-10-22): a real cat — TomTom's parts — whose idle is the appended `probeBack`
// (probe.scene.json: probeBackF places the front rig probeBackPose with NO marker, probeBackB the back rig
// probeBackPoseBack — head_back behind, tail in front, as vanilla idleB — with the marker), so the marker in a shot
// means the B frame plays. Facing away from data: properties.lock_orientation [1 0] — the orientation keys are read
// from `properties` (Character::init 0xf91c6..0xf9382; #105 had put them in `graphics`, where nothing reads them), and
// (1,0) is a back direction for facing sign +1 (Character::Face 0x10ce50); the lock also overrides every later turn.
// npm run test:artprobe -- --cat-back
ArtProbeCatBack {
    variant_of TomTom
    properties {
        lock_orientation [1 0]
    }
    graphics {
        movieclip _CAT
        name "ENEMY_TOMTOM_NAME"
        custom_cat_data TomTom
        scale 1.1
        shadow_size 1.1
        alt_animations [[idle probeBack]]
        tooltip "ENEMY_TOMTOM_DESC"
    }
}

// test-only (back-facing probe control): the same cat and animation at the default enemy facing — it plays probeBackF
// (the front rig, no marker), so a marker on this one would mean the default facing is already B
ArtProbeCatFacing {
    variant_of TomTom
    graphics {
        movieclip _CAT
        name "ENEMY_TOMTOM_NAME"
        custom_cat_data TomTom
        scale 1.1
        shadow_size 1.1
        alt_animations [[idle probeBack]]
        tooltip "ENEMY_TOMTOM_DESC"
    }
}

// test-only (back-facing probe, the shown pose): TomTom whose idle is `probeBackShow` — probeBackShowF and
// probeBackShowB BOTH place the back rig probeBackPoseBack (with the marker), so the back pose is drawn at any facing:
// does the game fill head_back with the cat's own head seen from behind?
ArtProbeCatBackShown {
    variant_of TomTom
    graphics {
        movieclip _CAT
        name "ENEMY_TOMTOM_NAME"
        custom_cat_data TomTom
        scale 1.1
        shadow_size 1.1
        alt_animations [[idle probeBackShow]]
        tooltip "ENEMY_TOMTOM_DESC"
    }
}
