// test-only: a Rat whose art is the ArtProbe clip from mods/_artprobe/swfs/probe.swf (built from art/probe.scene.json)
ArtProbe {
    variant_of Rat
    graphics {
        movieclip ArtProbe
        name "ENEMY_LILRAT_NAME"
        shadow_size .70
        tooltip "ENEMY_LILRAT_DESC"
    }
}

// test-only: a Rat drawn by the CatProbe cat rig (one passthrough colour per vanilla cat slot; npm run test:artprobe -- --cat)
ArtProbeCat {
    variant_of Rat
    graphics {
        movieclip CatProbe
        name "ENEMY_LILRAT_NAME"
        shadow_size .70
        tooltip "ENEMY_LILRAT_DESC"
    }
}
