mods: jokers-luck
timeout: 90s

# Load smoke for the data+native pair: the game must reach the main menu with the
# overlays applied and no NO_*_NAMED / GON_ERROR marker in debug.log (the runner turns
# those into `log-errors`), with mewframework active (the runner checks the framework
# log). `bind JokersGambit` needs a run in progress, which the console cannot start
# from the main menu yet (docs/ingame-testing.md, "Game-state assumptions"), so the
# in-combat assertions are not here.
wait frames 120
cmd listcmds
expect console "Executed: listcmds"
quit
