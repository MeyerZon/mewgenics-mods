mods: jokers-luck, _autoplay, _jokersluck-test
timeout: 120s
# Determinism (TDD target 12, RNG pinning): with the RNG pinned after the game's startup, the generated party and
# the JokersLuck rerolls are the same on every run, so the assertions are exact. OBSERVED 2026-10-20 with seed 42
# on build 25143593 (two runs, identical): party Wengar The Wion/Thief, Flint/Mage, Webster/Medic, Christine/Hunter;
# JokersLuck on the first cat 1 -> 10 -> 7 across the first three rounds -- until 2026-10-22, when those CRT-rand
# rerolls stopped repeating. Since framework API v5 the rerolls come from FW_Random, which `seed 42` also pins:
# OBSERVED 2026-10-22 (twice, identical): round 2 Wengar 5, Webster -7, Flint -5, Christine -4; round 3 Wengar -10,
# Webster 8, Flint -6, Christine 7 -- draws 0..7 of the seed-42 stream in turn order Wengar, Webster, Flint,
# Christine (fw_rng.c + jl_roll.c on the host give +5 -7 -5 -4 -10 +8 -6 +7). Operands are signed (since
# 2026-10-22, `fix/harness-negative-numbers`), so round 3 pins the negative values exactly too.
wait frames 120
seed 42
enter TacticsTest
wait turns 1
expect stacks JokersLuck on "Wengar The Wion" == 1
dump
wait rounds 1
expect stacks JokersLuck on 0 == 5
dump
wait rounds 1
expect stacks JokersLuck on 0 == -10
expect stacks JokersLuck on "Flint" == -6
expect stacks JokersLuck on "Webster" == 8
expect stacks JokersLuck on "Christine" == 7
dump
quit
