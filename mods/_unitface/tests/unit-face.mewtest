mods: _unitface, fw-3d
timeout: 150s
hide: false
# 3D phase M3 `face`: a unit model turns with Character::Face. _unitface gives the vanilla Rat models/face-box.obj
# (a box with a cyan FRONT face and a yellow BACK face). The harness's `face <unit> ...` (PR #114) calls
# Character::Face(dir, instant); mewframework reads the stored direction (Character+0x388) every combat frame, turns
# the model by yaw = atan2(-dx, -dy) and logs "unit model face: Rat handle=<h> dir=(dx dy) yaw=<deg> src=dir ms=<t>".
# Expected: (0,-1) front -> cyan face to the lower right; (-1,0) front mirrored -> cyan to the lower left;
# (1,0) back -> the yellow BACK face shows (it now looks to the lower left), no cyan; (0,1) back mirrored -> yellow to
# the lower right. editor/src/core/art/face-measure.ts judgeFace reads each shot (face colour + side of the box).
# No _autoplay: nobody acts, so only `face` turns the Rat. The seeded party + opponents are units 0..7, the spawned
# Rat is unit 8 (the expect gon line pins it).
wait frames 120
seed 42
enter TacticsTest
wait turns 1
cmd spawn Rat
expect console "Spawned Rat" within 10
wait frames 90
dump
expect gon 8 graphics.model.file == "models/face-box.obj"
face 8 0 -1
wait frames 30
expect unit 8 dirx == 0
expect unit 8 diry == -1
shot "front"
face 8 -1 0
wait frames 30
expect unit 8 dirx == -1
shot "front mirrored"
face 8 1 0
wait frames 30
expect unit 8 dirx == 1
expect unit 8 facing == "B"
shot "back"
face 8 0 1
wait frames 30
expect unit 8 diry == 1
shot "back mirrored"
face 8 front
wait frames 30
expect unit 8 facing == "F"
shot "front again"
quit
