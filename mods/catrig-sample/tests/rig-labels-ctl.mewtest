mods: catrig-sample, _autoplay
timeout: 300s
hide: false
# The control of rig-labels.mewtest: the same seeded _autoplay fight against RigSampleVanillaCat (the same parts,
# the vanilla CatTest with every label). What the game does with a normal cat — its HP per dump, whether its unit
# stays in the walk after it dies, the rounds — is the reference the rig cat's missing labels are compared against.
wait frames 120
seed 42
enter TacticsTest
wait frames 300
cmd spawn RigSampleVanillaCat
expect console "Spawned RigSampleVanillaCat" within 10
dump
wait frames 5
shot "l01"
wait frames 5
shot "l02"
wait frames 5
shot "l03"
wait frames 5
shot "l04"
wait frames 5
shot "l05"
dump
wait frames 5
shot "l06"
wait frames 5
shot "l07"
wait frames 5
shot "l08"
wait frames 5
shot "l09"
wait frames 5
shot "l10"
dump
