# extracted game assets and binaries never go in the repo
.extracted/
*.gpak
*.swf
# art-pipeline build output: built SWFs + the generated swflist.gon.append (rebuilt by the editor / e2e)
mods/*/swfs/
*.wav
*.ogg
*.sav
*.exe
*.dll
*.o
*.obj
build/
# local launcher output
launch-*.local.bat
.analysis/

# editor: generated caches and dev-only toolchain (never committed)
editor/data/
editor/node_modules/
# editor: the Vite build of the web UI (npm run build); served by web/server.mjs
editor/web/dist/
# editor: Ruffle's runtime files, vendored from node_modules by scripts/vendor-ruffle.ts (npm run build / dev)
editor/web/public/ruffle/
# editor: VectorCraft's prebuilt web build (73 MB wasm + glue + licences), downloaded hash-pinned from GitHub Releases
# by scripts/vendor-vectorcraft.ts (npm run build / dev); the zip itself is cached under the ignored editor/data/vendor/
editor/web/public/vectorcraft/
editor/web/public/vectorcraft.tmp/
# editor: Playwright (dev-only) run output
editor/test-results/
editor/playwright-report/
# art probes: big generated PNGs (written by editor/scripts/art-probe.ts --raster)
mods/*/art/generated/
