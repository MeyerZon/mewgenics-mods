                    },
                    "object": {
                      "type": "string",
                      "description": "name"
                    },
                    "weight": {
                      "type": "number",
                      "description": "weight (default 1)"
                    }
                  },
                  "additionalProperties": false
                },
                "description": "a weighted random list instead of one id"
              }
            },
            "required": [
              "op",
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "description": "applied in order to level / base64 / the file on disk / an empty 10x10 room"
        },
        "dryRun": {
          "type": "boolean",
          "description": "encode and validate, write nothing (returns base64)"
        }
      },
      "required": [
        "mod",
        "path"
      ],
      "additionalProperties": false
    }
  }
