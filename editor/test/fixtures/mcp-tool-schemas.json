[
  {
    "name": "list_base_data",
    "inputSchema": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "description": "optional category to list entries for"
        },
        "filter": {
          "type": "string",
          "description": "optional case-insensitive substring filter"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "read_base_entry",
    "inputSchema": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "description": "e.g. abilities, passives, items, characters, statuses"
        },
        "name": {
          "type": "string",
          "description": "the entry's GON key, e.g. Spin"
        }
      },
      "required": [
        "category",
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "search_components",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "substring to match against component class names"
        },
        "whereUsed": {
          "type": "boolean",
          "description": "also return where the top matches are referenced"
        },
        "limit": {
          "type": "number",
          "description": "max names to return (default 50)"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "read_mod",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "mod folder name under mods/"
        },
        "includeText": {
          "type": "boolean",
          "description": "include overlay file contents"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "write_overlay",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "path relative to the mod folder"
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "mod",
        "path",
        "content"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "validate_mod",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "optional overlay path to override with unsaved text"
        },
        "text": {
          "type": "string",
          "description": "optional unsaved content for `path`"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "preview_merge",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "overlay path relative to the mod folder"
        },
        "text": {
          "type": "string",
          "description": "optional unsaved overlay content"
        },
        "includeFullGon": {
          "type": "boolean",
          "description": "include the full effective GON text"
        }
      },
      "required": [
        "mod",
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_registered_native_names",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "new_from_template",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ability",
            "passive",
            "item",
            "status-data"
          ]
        },
        "name": {
          "type": "string",
          "description": "the new entry's GON key, e.g. MyCoolSpin"
        },
        "options": {
          "type": "object",
          "description": "scaffold options (displayName, desc, parent, mana, statusEffect, dryRun, ...)"
        }
      },
      "required": [
        "mod",
        "kind",
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_ingame_tests",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "optional mod folder to restrict to"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "run_ingame_test",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "mod folder; its tests/ dir is searched and it is the default -modpaths entry"
        },
        "test": {
          "type": "string",
          "description": "script name without .mewtest, e.g. smoke"
        },
        "script": {
          "type": "string",
          "description": "inline .mewtest text (alternative to `test`)"
        },
        "timeoutMs": {
          "type": "number",
          "description": "override the script's timeout"
        },
        "hide": {
          "type": "boolean",
          "description": "hide the game window (default true)"
        },
        "clean": {
          "type": "boolean",
          "description": "clean exit: after the end event let the game shut itself down for a complete debug.log (default false: exit immediately); the harness exits after 3 s and the runner kills after 5 s if it lingers"
        },
        "savesuffix": {
          "type": "string",
          "description": "override the save suffix (default dev); never empty"
        },
        "includeEvents": {
          "type": "boolean",
          "description": "include the raw JSONL events in the report"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "start_ingame_session",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "mod folder; its tests/ dir is searched and it is the default -modpaths entry"
        },
        "test": {
          "type": "string",
          "description": "script name without .mewtest (made interactive: the DLL idles at its end)"
        },
        "script": {
          "type": "string",
          "description": "inline .mewtest text (alternative to `test`); e.g. \"wait frames 120\\nenter TacticsTest\\nwait turns 1\\n\""
        },
        "timeoutMs": {
          "type": "number",
          "description": "the session's wall-clock budget (default the script's timeout, 120 s); the game is killed after it"
        },
        "hide": {
          "type": "boolean",
          "description": "hide the game window (default true)"
        },
        "savesuffix": {
          "type": "string",
          "description": "override the save suffix (default dev); never empty"
        },
        "connectTimeoutMs": {
          "type": "number",
          "description": "how long to wait for the DLL's pipe after the launch (default 30000)"
        },
        "waitIdle": {
          "type": "boolean",
          "description": "return only once the script has run to its end and the DLL idles (default true); false returns right after the pipe connects, and requests are then served inside the script's waits"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "ingame_exec",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "from start_ingame_session"
        },
        "cmd": {
          "type": "string",
          "description": "a console line to run (op exec), e.g. \"spawn Rat\""
        },
        "op": {
          "type": "string",
          "enum": [
            "exec",
            "dump",
            "quit"
          ],
          "description": "exec (default when cmd is given) | dump (the units event) | quit (ends the session and returns the report)"
        },
        "frames": {
          "type": "number",
          "description": "frames to keep collecting console output after the command (default 3, max 600; ~180 frames/s hidden)"
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "stop_ingame_session",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "from start_ingame_session"
        },
        "includeEvents": {
          "type": "boolean",
          "description": "include the raw JSONL events in the report"
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_art_scenes",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "mod folder; lists art/*.scene.json, built swfs/*.swf and art assets"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "read_art_scene",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "scene file inside the mod, e.g. art/my_rat.scene.json"
        }
      },
      "required": [
        "mod",
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "write_art_scene",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "scene file inside the mod (art/<name>.scene.json)"
        },
        "scene": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "the whole scene (docs/art-preview-plan.md §2: version, name, shapes, bitmaps, sprites, exports, stage_instances)"
        },
        "force": {
          "type": "boolean",
          "description": "write even when the scene has validation errors (they are returned)"
        },
        "dryRun": {
          "type": "boolean",
          "description": "validate only, write nothing"
        }
      },
      "required": [
        "mod",
        "path",
        "scene"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "new_art_scene",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "scene name, becomes art/<name>.scene.json"
        },
        "starter": {
          "type": "boolean",
          "description": "start from the example scene (default true)"
        },
        "template": {
          "type": "string",
          "enum": [
            "cat-animation"
          ],
          "description": "\"cat-animation\": a cat rig <animation>Pose plus an _Append_CatTest donor sprite with the labeled frames <animation>F / <animation>B, each placing the rig as the child `ani` at depth 1 (the vanilla CatTest shape; the engine restarts `ani` on every play)"
        },
        "animation": {
          "type": "string",
          "description": "the animation name for template cat-animation (default: the scene name, which must then be an identifier); GON refers to it bare: alt_animations [[idle <animation>]] or an ability's animation <animation>"
        }
      },
      "required": [
        "mod",
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "import_svg",
    "inputSchema": {
      "type": "object",
      "properties": {
        "svgText": {
          "type": "string",
          "description": "SVG markup (or pass mod + path of an .svg inside the mod)"
        },
        "mod": {
          "type": "string",
          "description": "mod folder (for path, and for into)"
        },
        "path": {
          "type": "string",
          "description": "an .svg inside the mod"
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "importer options: applyViewBox, quantizeGray, grayTolerance, dropStrokes"
        },
        "into": {
          "type": "object",
          "properties": {
            "scene": {
              "type": "string",
              "description": "scene file inside the mod to add the shape to"
            },
            "shapeId": {
              "type": "string",
              "description": "the new shape's id"
            },
            "replace": {
              "type": "boolean",
              "description": "overwrite a shape with that id"
            }
          },
          "required": [
            "scene",
            "shapeId"
          ],
          "additionalProperties": false,
          "description": "save the imported shape into a scene (needs mod); without it nothing is written"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "export_svg",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "scene file inside the mod"
        },
        "shapeId": {
          "type": "string",
          "description": "the shape to export"
        }
      },
      "required": [
        "mod",
        "path",
        "shapeId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "build_swf",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "scene file inside the mod"
        },
        "abc": {
          "type": "string",
          "enum": [
            "none",
            "stub"
          ],
          "description": "DoABC: none (default; SymbolClass binds the name) or stub"
        },
        "dryRun": {
          "type": "boolean",
          "description": "emit + self-check, write nothing"
        },
        "writeSwflist": {
          "type": "boolean",
          "description": "also write swfs/swflist.gon.append (default true)"
        }
      },
      "required": [
        "mod",
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "inspect_swf",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "a built SWF inside the mod, e.g. swfs/my_rat.swf"
        }
      },
      "required": [
        "mod",
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "check_game_build",
    "inputSchema": {
      "type": "object",
      "properties": {
        "exe": {
          "type": "string",
          "description": "optional path to a Mewgenics.exe to check instead of the installed one (read-only)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "port_bindings",
    "inputSchema": {
      "type": "object",
      "properties": {
        "build": {
          "type": "string",
          "description": "the NEW Steam build id (digits), e.g. 25200000; names bindings/<build>.json"
        },
        "exe": {
          "type": "string",
          "description": "path to the new Mewgenics.exe (default: the installed game)"
        },
        "from": {
          "type": "string",
          "description": "the manifest to port from (default: the newest bindings/<build>.json)"
        },
        "version": {
          "type": "string",
          "description": "the new game version string, e.g. 1.1.21300"
        },
        "resolve": {
          "type": "object",
          "description": "name -> 0xRVA answers for ambiguous/failed entries",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dryRun": {
          "type": "boolean",
          "description": "default true; false writes bindings/<build>.json + the report"
        }
      },
      "required": [
        "build"
      ],
      "additionalProperties": false
    }
  }
]
