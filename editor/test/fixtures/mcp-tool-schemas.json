[
  {
    "name": "list_base_data",
    "inputSchema": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "description": "optional category to list entries for"
        },
        "filter": {
          "type": "string",
          "description": "optional case-insensitive substring filter"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "read_base_entry",
    "inputSchema": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "description": "e.g. abilities, passives, items, characters, statuses"
        },
        "name": {
          "type": "string",
          "description": "the entry's GON key, e.g. Spin"
        }
      },
      "required": [
        "category",
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "search_components",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "substring to match against component class names"
        },
        "whereUsed": {
          "type": "boolean",
          "description": "also return where the top matches are referenced"
        },
        "limit": {
          "type": "number",
          "description": "max names to return (default 50)"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "read_mod",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "mod folder name under mods/"
        },
        "includeText": {
          "type": "boolean",
          "description": "include overlay file contents"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "write_overlay",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "path relative to the mod folder"
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "mod",
        "path",
        "content"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "validate_mod",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "optional overlay path to override with unsaved text"
        },
        "text": {
          "type": "string",
          "description": "optional unsaved content for `path`"
        },
        "modpaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "optional: the mods loaded together, in -modpaths order; adds the cross-mod checks (two mods appending the same _Append_ label, two mods shipping the same swfs/<name>.swf, a label or SWF name vanilla already has)"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "preview_merge",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "overlay path relative to the mod folder"
        },
        "text": {
          "type": "string",
          "description": "optional unsaved overlay content"
        },
        "includeFullGon": {
          "type": "boolean",
          "description": "include the full effective GON text"
        }
      },
      "required": [
        "mod",
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_registered_native_names",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "new_from_template",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ability",
            "passive",
            "item",
            "status-data",
            "room",
            "tileset-variant",
            "particle",
            "vfx-ability"
          ]
        },
        "name": {
          "type": "string",
          "description": "the new entry's GON key, e.g. MyCoolSpin"
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "scaffold options (displayName, desc, parent, mana, statusEffect, movieclip (particle / vfx-ability: the SWF clip), dryRun, ...)"
        }
      },
      "required": [
        "mod",
        "kind",
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_ingame_tests",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "optional mod folder to restrict to"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "run_ingame_test",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "mod folder; its tests/ dir is searched and it is the default -modpaths entry"
        },
        "test": {
          "type": "string",
          "description": "script name without .mewtest, e.g. smoke"
        },
        "script": {
          "type": "string",
          "description": "inline .mewtest text (alternative to `test`)"
        },
        "timeoutMs": {
          "type": "number",
          "description": "override the script's timeout"
        },
        "hide": {
          "type": "boolean",
          "description": "hide the game window (default true)"
        },
        "clean": {
          "type": "boolean",
          "description": "clean exit: after the end event let the game shut itself down for a complete debug.log (default false: exit immediately); the harness exits after 3 s and the runner kills after 5 s if it lingers"
        },
        "savesuffix": {
          "type": "string",
          "description": "override the save suffix (default dev); never empty"
        },
        "includeEvents": {
          "type": "boolean",
          "description": "include the raw JSONL events in the report"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "start_ingame_session",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "mod folder; its tests/ dir is searched and it is the default -modpaths entry"
        },
        "test": {
          "type": "string",
          "description": "script name without .mewtest (made interactive: the DLL idles at its end)"
        },
        "script": {
          "type": "string",
          "description": "inline .mewtest text (alternative to `test`); e.g. \"wait frames 120\\nenter TacticsTest\\nwait turns 1\\n\""
        },
        "timeoutMs": {
          "type": "number",
          "description": "the session's wall-clock budget (default the script's timeout, 120 s); the game is killed after it"
        },
        "hide": {
          "type": "boolean",
          "description": "hide the game window (default true)"
        },
        "savesuffix": {
          "type": "string",
          "description": "override the save suffix (default dev); never empty"
        },
        "connectTimeoutMs": {
          "type": "number",
          "description": "how long to wait for the DLL's pipe after the launch (default 30000)"
        },
        "waitIdle": {
          "type": "boolean",
          "description": "return only once the script has run to its end and the DLL idles (default true); false returns right after the pipe connects, and requests are then served inside the script's waits"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "ingame_exec",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "from start_ingame_session"
        },
        "cmd": {
          "type": "string",
          "description": "a console line to run (op exec), e.g. \"spawn Rat\""
        },
        "op": {
          "type": "string",
          "enum": [
            "exec",
            "dump",
            "quit"
          ],
          "description": "exec (default when cmd is given) | dump (the units event) | quit (ends the session and returns the report)"
        },
        "frames": {
          "type": "number",
          "description": "frames to keep collecting console output after the command (default 3, max 600; ~180 frames/s hidden)"
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "stop_ingame_session",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "from start_ingame_session"
        },
        "includeEvents": {
          "type": "boolean",
          "description": "include the raw JSONL events in the report"
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_art_scenes",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "mod folder; lists art/*.scene.json, built swfs/*.swf and art assets"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "read_art_scene",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "scene file inside the mod, e.g. art/my_rat.scene.json"
        }
      },
      "required": [
        "mod",
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "write_art_scene",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "scene file inside the mod (art/<name>.scene.json)"
        },
        "scene": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "the whole scene (docs/art-preview-plan.md §2: version, name, shapes, bitmaps, sprites, exports, stage_instances)"
        },
        "force": {
          "type": "boolean",
          "description": "write even when the scene has validation errors (they are returned)"
        },
        "dryRun": {
          "type": "boolean",
          "description": "validate only, write nothing"
        }
      },
      "required": [
        "mod",
        "path",
        "scene"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "new_art_scene",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "scene name, becomes art/<name>.scene.json"
        },
        "starter": {
          "type": "boolean",
          "description": "start from the example scene (default true)"
        },
        "template": {
          "type": "string",
          "enum": [
            "cat-animation"
          ],
          "description": "\"cat-animation\": a front cat rig <animation>Pose, a back-facing rig <animation>PoseBack (head_back behind, tail in front, as vanilla idleB) and an _Append_CatTest donor sprite with the labeled frames <animation>F (front rig) / <animation>B (back rig), each placing its rig as the child `ani` at depth 1 (the vanilla CatTest shape; the engine restarts `ani` on every play)"
        },
        "animation": {
          "type": "string",
          "description": "the animation name for template cat-animation (default: the scene name, which must then be an identifier); GON refers to it bare: alt_animations [[idle <animation>]] or an ability's animation <animation>"
        },
        "fourWay": {
          "type": "boolean",
          "description": "template cat-animation: emit the four-way quartet <animation>LF / RF / LB / RB (the L frames mirrored) for a character with graphics { four_way_animations true }; vanilla CatTest has no four-way label"
        }
      },
      "required": [
        "mod",
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "import_svg",
    "inputSchema": {
      "type": "object",
      "properties": {
        "svgText": {
          "type": "string",
          "description": "SVG markup (or pass mod + path of an .svg inside the mod)"
        },
        "mod": {
          "type": "string",
          "description": "mod folder (for path, and for into)"
        },
        "path": {
          "type": "string",
          "description": "an .svg inside the mod"
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "importer options: applyViewBox, quantizeGray, grayTolerance, dropStrokes"
        },
        "into": {
          "type": "object",
          "properties": {
            "scene": {
              "type": "string",
              "description": "scene file inside the mod to add the shape to"
            },
            "shapeId": {
              "type": "string",
              "description": "the new shape's id"
            },
            "replace": {
              "type": "boolean",
              "description": "overwrite a shape with that id"
            }
          },
          "required": [
            "scene",
            "shapeId"
          ],
          "additionalProperties": false,
          "description": "save the imported shape into a scene (needs mod); without it nothing is written"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "import_bitmap",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string",
          "description": "mod folder (for file, for scene, and where base64 is written as art/<id>.png)"
        },
        "file": {
          "type": "string",
          "description": "a .png already inside the mod, e.g. art/Photo.png"
        },
        "base64": {
          "type": "string",
          "description": "or the PNG bytes, base64 (8-bit, non-interlaced; < 4096 in both dimensions)"
        },
        "scene": {
          "type": "string",
          "description": "scene file inside the mod to add it to; without it the PNG is only checked (size + findings)"
        },
        "id": {
          "type": "string",
          "description": "shape id (default: the file name); the bitmap is <id>Bmp, the clip <id>Clip"
        },
        "mode": {
          "type": "string",
          "enum": [
            "sprite",
            "background",
            "fill"
          ],
          "description": "sprite (default): a 1-frame clip exported for graphics.movieclip, origin at the feet; background: the same with origin top-left, for a tileset combat_background plate; fill: only the bitmap + a shape to place yourself"
        },
        "scale": {
          "type": "number",
          "description": "clip px per texel (default 1; vanilla combat plates: 2000x1500 at 0.7667). Above 1 it looks soft in-game (bitmap-upscaled)"
        },
        "origin": {
          "type": "string",
          "enum": [
            "top-left",
            "center",
            "bottom-center"
          ],
          "description": "where clip (0,0) sits on the image"
        },
        "repeat": {
          "type": "boolean",
          "description": "tile the bitmap outside its rectangle (fill type 0x40) instead of streaking the edge texels (0x41)"
        },
        "smooth": {
          "type": "boolean",
          "description": "false: pixel-snapped sampling (0x43 / 0x42) for pixel art; default true: filtered with mips"
        },
        "area": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "description": "px"
            },
            "height": {
              "type": "number",
              "description": "px"
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false,
          "description": "fill mode: the shape's size in clip px; with repeat the bitmap tiles over it"
        },
        "exportName": {
          "type": "string",
          "description": "sprite / background: the linkage name (default the id)"
        },
        "replace": {
          "type": "boolean",
          "description": "overwrite existing ids / export"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "export_svg",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "scene file inside the mod"
        },
        "shapeId": {
          "type": "string",
          "description": "the shape to export"
        }
      },
      "required": [
        "mod",
        "path",
        "shapeId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "bake_glow",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "scene file inside the mod"
        },
        "shapeId": {
          "type": "string",
          "description": "the shape to put a halo under"
        },
        "color": {
          "type": "string",
          "description": "halo colour: #rrggbb[aa] or gray:N (its alpha is the ceiling)"
        },
        "blur": {
          "type": "number",
          "description": "halo reach in the shape's local px (0.5..255)"
        },
        "strength": {
          "type": "number",
          "description": "alpha multiplier of the falloff (default 1; >1 saturates the inner bands)"
        },
        "kind": {
          "type": "string",
          "enum": [
            "glow",
            "dropShadow"
          ],
          "description": "glow (centred, default) or dropShadow (offset by dx, dy)"
        },
        "dx": {
          "type": "number",
          "description": "dropShadow offset x, local px (default 4)"
        },
        "dy": {
          "type": "number",
          "description": "dropShadow offset y, local px (default 4)"
        },
        "steps": {
          "type": "number",
          "description": "concentric bands 1..8 (default 4)"
        },
        "replace": {
          "type": "boolean",
          "description": "re-bake over an existing <shapeId>_glow"
        }
      },
      "required": [
        "mod",
        "path",
        "shapeId",
        "color",
        "blur"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "build_swf",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "scene file inside the mod"
        },
        "abc": {
          "type": "string",
          "enum": [
            "none",
            "stub"
          ],
          "description": "DoABC: none (default; SymbolClass binds the name) or stub"
        },
        "dryRun": {
          "type": "boolean",
          "description": "emit + self-check, write nothing"
        },
        "writeSwflist": {
          "type": "boolean",
          "description": "also write swfs/swflist.gon.append (default true)"
        }
      },
      "required": [
        "mod",
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "inspect_swf",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "a built SWF inside the mod, e.g. swfs/my_rat.swf"
        }
      },
      "required": [
        "mod",
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "check_game_build",
    "inputSchema": {
      "type": "object",
      "properties": {
        "exe": {
          "type": "string",
          "description": "optional path to a Mewgenics.exe to check instead of the installed one (read-only)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "port_bindings",
    "inputSchema": {
      "type": "object",
      "properties": {
        "build": {
          "type": "string",
          "description": "the NEW Steam build id (digits), e.g. 25200000; names bindings/<build>.json"
        },
        "exe": {
          "type": "string",
          "description": "path to the new Mewgenics.exe (default: the installed game)"
        },
        "from": {
          "type": "string",
          "description": "the manifest to port from (default: the newest bindings/<build>.json)"
        },
        "version": {
          "type": "string",
          "description": "the new game version string, e.g. 1.1.21300"
        },
        "resolve": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "name -> 0xRVA answers for ambiguous/failed entries"
        },
        "dryRun": {
          "type": "boolean",
          "description": "default true; false writes bindings/<build>.json + the report"
        }
      },
      "required": [
        "build"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "vectorcraft_exec",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "scene": {
          "type": "string",
          "description": "scene file inside the mod, e.g. art/my_rat.scene.json"
        },
        "shapeId": {
          "type": "string",
          "description": "the shape to open in VectorCraft first (its SVG, as export_svg writes it); omit to start from a blank artboard of the stage size"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "description": "an engine command id, e.g. shape.rectangle, shape.ellipse, path.create, object.move, object.setProps (the app lists all ~1,090 with their params; coordinates are artboard px = the shape's SVG viewBox moved to 0,0)"
              },
              "params": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "description": "the command's params, e.g. { x, y, width, height } or { d: 'M0 0 L10 0 …' }"
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          },
          "description": "run in order through window.vectorcraft.execute; a failure stops the rest unless continueOnError"
        },
        "exportTo": {
          "type": "string",
          "description": "the shape the exported drawing replaces (default shapeId). Omit together with shapeId to only run the commands and get the SVG text back"
        },
        "screenshot": {
          "type": "boolean",
          "description": "also save a PNG of the canvas under editor/data/vectorcraft/ and return screenshotPath"
        },
        "continueOnError": {
          "type": "boolean",
          "description": "keep running after a failed command (default false)"
        },
        "timeoutMs": {
          "type": "number",
          "description": "how long to wait for the app to start in headless Chromium (default 120000)"
        },
        "webgl": {
          "type": "boolean",
          "description": "force the WebGL2 backend (?webgl; default true in headless)"
        }
      },
      "required": [
        "mod",
        "scene",
        "commands"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "pack_mod",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "force": {
          "type": "boolean",
          "description": "pack despite validation errors, failed SWF builds or missing native DLLs (the result says what was forced)"
        },
        "init": {
          "type": "boolean",
          "description": "draft mods/<mod>/mod.json from description.json first when it is missing"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "install_mod",
    "inputSchema": {
      "type": "object",
      "properties": {
        "zip": {
          "type": "string",
          "description": "path to the mod zip to install into mods/<name>/"
        },
        "acceptBuildMismatch": {
          "type": "boolean",
          "description": "install although the mod's gameBuild is not the installed game's build (pass only after the user agreed to the returned prompt)"
        }
      },
      "required": [
        "zip"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "read_level",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "a level inside the mod, levels/<folder>/<name>.lvl; omit to list the mod's levels"
        },
        "palette": {
          "type": "boolean",
          "description": "also return the tile (tiles.gon) and object (spawns.gon) palettes: base + this mod's overlays, with names, classes and swatch colours"
        }
      },
      "required": [
        "mod"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "write_level",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mod": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "levels/<folder>/<name>.lvl inside the mod (nothing else is writable)"
        },
        "level": {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "width": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "objectPalette": {
              "type": "string"
            },
            "tilePalette": {
              "type": "string"
            },
            "tiles": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "weight": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "id",
                        "weight"
                      ],
                      "additionalProperties": false
                    }
                  }
                ]
              }
            },
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "id": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "weight": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "id",
                            "weight"
                          ],
                          "additionalProperties": false
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "x",
                  "y",
                  "id"
                ],
                "additionalProperties": false
              }
            },
            "raw": {
              "type": "object",
              "properties": {
                "layers": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "a": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "b": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "width2": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "height2": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "pad1": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "pad2": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "trailer": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "layers",
                "a",
                "b",
                "width2",
                "height2",
                "pad1",
                "pad2",
                "trailer"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "width",
            "height",
            "objectPalette",
            "tilePalette",
            "tiles",
            "objects"
          ],
          "additionalProperties": false,
          "description": "the whole level as read_level returns it (version, width, height, objectPalette, tilePalette, tiles row-major: id | [{id, weight}], objects: [{x, y, id}], raw?)"
        },
        "base64": {
          "type": "string",
          "description": "or the level file's bytes"
        },
        "edits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "tile",
                  "object",
                  "remove"
                ],
                "description": "tile: paint the cell's tile; object: put an object on the cell (replaces the first one there); remove: clear the cell's objects"
              },
              "x": {
                "type": "number",
                "description": "column 0..width-1"
              },
              "y": {
                "type": "number",
                "description": "row 0..height-1"
              },
              "id": {
                "type": "number",
                "description": "a tiles.gon / spawns.gon id"
              },
              "object": {
                "type": "string",
                "description": "a spawns.gon object/utility name instead of an id, e.g. Rat, PlayerSpawn"
              },
              "random": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
