mods: jokers-luck, dev-sandbox
savesuffix: dev
timeout: 90s
hide: false

# a comment
wait frames 120
cmd bind JokersGambit # not a comment, part of the command
expect console "No command named \"bind\" found" within 5
expect noconsole "NO_ABILITY_NAMED"
expect status JokersLuck on "Mr Whiskers"
expect status LuckUp on 0
expect units >= 2
dump
log "hello \"world\""
wait turns 2
wait ms 500
expect log "Save File Suffix: dev"
enter TacticsTest
wait rounds 1
expect round >= 2
expect stacks JokersLuck on 0 == 1
expect stacks LuckUp on "Mr Whiskers" varied
quit 0
