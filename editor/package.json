{
  "name": "mewgenics-mod-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local data-layer mod editor for Mewgenics: GON/CSV overlay authoring, validation, merge-preview, MCP server, and web UI (Vite + React; zod at the API boundary).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:index": "node scripts/build-index.mjs",
    "build": "vite build",
    "dev": "vite",
    "mcp": "node src/mcp/server.mjs",
    "web": "node web/server.mjs",
    "test": "node test/run-tests.mjs",
    "test:ingame": "node scripts/ingame.mjs",
    "test:swfgate": "node scripts/swf-gate.mjs",
    "test:e2e": "vite build && playwright test",
    "bindings:gen": "node ../tools/bindings/gen-headers.mjs",
    "bindings:check": "node ../tools/bindings/gen-headers.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
